{
  "name": "mimic-local",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Teach your browser a workflow. Turn it into a reusable command.",
  "scripts": {
    "dev": "node server/index.js --dev",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "check": "tsc --noEmit",
    "build:extension": "node scripts/build-extension.mjs",
    "build:cloud": "npm run build:extension && vite build --mode cloud",
    "test:extension": "node --test tests/extension.test.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "playwright": "^1.55.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
